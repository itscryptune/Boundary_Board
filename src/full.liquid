<div class="layout">
  <div class="bb bb-full">
    <div class="bb-header bb-branded">
      <div class="bb-header-main">
        <img class="bb-logo"
          src="https://raw.githubusercontent.com/itscryptune/Boundary_Board/main/logo/boundaryboard-logo.svg"
          alt="BoundaryBoard cricket logo">
        <span class="bb-brand-name">BOUNDARYBOARD</span>
      </div>
      <div class="bb-header-side">
        {% if featured %}
          <span class="bb-format">{{ featured.format | escape }}</span>
          <span class="bb-badge {% if featured.state == 'LIVE' %}bb-badge-live{% endif %}">{{ featured.state }}</span>
        {% else %}
          <span class="bb-format">CRICKET SCOREBOARD</span>
        {% endif %}
      </div>
    </div>
    <div class="bb-main">
      {% if featured %}
      <div class="bb-heading">{{ featured.name | escape }}</div>
      <div class="bb-versus">
        <div class="bb-team">
          <div class="bb-code">{{ featured.team1.short | escape }}</div>
          <div class="bb-name">{{ featured.team1.name | escape }}</div>
          <div class="bb-score">{{ featured.team1_score | escape }}</div>
          <div class="bb-overs">{{ featured.team1_overs | escape }}</div>
        </div> 
        <div class="bb-vs-centre">
          <div class="bb-vs-line"></div>
          <div class="bb-vs">VS</div>
          <div class="bb-vs-state">{{ featured.state }}</div>
          <div class="bb-vs-line"></div>
        </div>
        <div class="bb-team">
          <div class="bb-code">{{ featured.team2.short | escape }}</div>
          <div class="bb-name">{{ featured.team2.name | escape }}</div>
          <div class="bb-score">{{ featured.team2_score | escape }}</div> 
          <div class="bb-overs">{{ featured.team2_overs | escape }}</div>
        </div>
      </div>
      <div class="bb-status">{{ featured.status | escape }}</div>
      <div class="bb-venue">{{ featured.venue | escape }}</div>
      {% if other_matches.size > 0 %}
        <div class="bb-other-section">
        <div class="bb-other-title">OTHER MATCHES</div>
        <div class="bb-others">
          {% for match in other_matches %}
            <div class="bb-other-card">
              <div class="bb-other-label">{{ match.format | escape }} · {{ match.state }}</div>
              <div class="bb-other-score"> 
                <span>{{ match.team1.short | escape }} {{ match.team1_score | escape }}</span>
                <span>{{ match.team2.short | escape }} {{ match.team2_score | escape }}</span>
              </div> 
            </div>
          {% endfor %}
        </div>
        </div>
      {% endif %}

      {% else %}
      <div class="bb-status">
        {% if board_state == "ERROR" %}Scores unavailable{% else %}No matches right now{% endif %}
        — {{ board_message | escape }}
      </div>
      {% endif %}
    </div> 
    <div class="bb-footer bb-footer-row">
      <span>{{ total_count | default: 0 }} MATCHES &nbsp;·&nbsp; {{ live_count | default: 0 }} LIVE</span>
      <span class="bb-footer-source">LAST SCREEN UPDATE:{{ render_time }} &nbsp;·&nbsp; CricketData.org</span>
    </div>
  </div>
</div>
<div class="title_bar"><span class="title">BoundaryBoard</span></div>
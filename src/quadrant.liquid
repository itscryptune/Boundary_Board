<div class="layout">
  <div class="bb bb-mini">
    <div class="bb-header">BOUNDARYBOARD</div>
    <div class="bb-main">
      {% if featured %}
        <div class="bb-heading">{{ featured.format | escape }} · {{ featured.state }}</div>
        <div class="bb-versus">
          <div class="bb-team">
            <div class="bb-code">{{ featured.team1.short | escape }}</div>
            <div class="bb-score">{{ featured.team1_score | escape }}</div>
          </div>
          <div class="bb-vs">VS</div>
          <div class="bb-team">
            <div class="bb-code">{{ featured.team2.short | escape }}</div>
            <div class="bb-score">{{ featured.team2_score | escape }}</div>
          </div>
        </div>
        <div class="bb-status">{{ featured.status | truncate: 60 | escape }}</div>
      {% else %}
        <div class="bb-status">{{ board_message | escape }}</div>
      {% endif %}
    </div>
    <div class="bb-footer">CricketData.org</div>
  </div>
</div>
<div class="title_bar"><span class="title">BoundaryBoard</span></div>